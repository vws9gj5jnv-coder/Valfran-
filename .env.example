# ============================================================
# VALFRAN — variables d'environnement (copier vers .env.local)
# Aucune de ces valeurs ne doit être préfixée par NEXT_PUBLIC_.
# ============================================================

# --- Général
SITE_URL=http://localhost:3000
# true = données fictives, tarifs démo, envois simulés, bandeau « démonstration ».
# Par défaut : true sans DATABASE_URL (PGlite), false avec DATABASE_URL.
DEMO_MODE=true
# Autoriser l'indexation d'un site en mode démo hébergé (par défaut : non)
# ALLOW_INDEXING=true
# Sel pour les empreintes anonymes (IP, plaques dans les journaux). Générer : openssl rand -hex 32
HASH_SALT=change-me

# --- Base de données
# Vide = PGlite (PostgreSQL embarqué, fichier local) — développement / démonstration.
# Production : PostgreSQL managé (Supabase, Neon, Scaleway…)
# DATABASE_URL=postgres://user:password@host:5432/valfran?sslmode=require
PGLITE_DIR=.data/pglite
# DB_POOL_MAX=5

# --- Compte administrateur
# Production : créer le compte avec  ADMIN_EMAIL=… ADMIN_PASSWORD=… npm run admin:create
# Mot de passe du compte démo (obligatoire pour l'activer en production)
# DEMO_ADMIN_PASSWORD=
# LOGIN_ATTEMPTS_PER_15MIN=10

# --- Identification par plaque : demo | http | none
PLATE_PROVIDER=demo
# PLATE_API_URL=https://api.fournisseur.example/v1/vehicles?plate={plate}
# PLATE_API_KEY=
PLATE_LOOKUPS_PER_HOUR=10
PLATE_LOOKUPS_PER_DAY=300

# --- Adresses : local (liste des communes) | ban (Base Adresse Nationale, gratuite)
GEOCODER_PROVIDER=local

# --- E-mails : demo (simulés) | resend | brevo | none
EMAIL_PROVIDER=demo
# EMAIL_API_KEY=
# EMAIL_FROM=VALFRAN <rendez-vous@votre-domaine.fr>
# ADMIN_NOTIFY_EMAIL=vous@votre-domaine.fr

# --- SMS : demo (simulés) | brevo | none
SMS_PROVIDER=demo
# SMS_API_KEY=
# SMS_SENDER=VALFRAN

# --- Photos : local | supabase
STORAGE_PROVIDER=local
UPLOAD_DIR=.data/uploads
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=valfran-private

# --- Agenda : flux iCalendar privé (≥ 24 caractères aléatoires). Générer : openssl rand -hex 24
# CALENDAR_FEED_TOKEN=

# --- Mesure d'audience sans cookie : none | plausible
ANALYTICS_PROVIDER=none
# ANALYTICS_DOMAIN=votre-domaine.fr
# ANALYTICS_SRC=https://plausible.io/js/script.js

# --- Anti-abus
BOOKINGS_PER_HOUR=8

# --- Paiement en ligne : non implémenté (none)
PAYMENT_PROVIDER=none
